DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=change_me
DB_NAME=hrms_db
# Generate a unique value before deploying. STRICT_ENV=1 aborts on the default secret.
JWT_SECRET=hrms_cangjie_jwt_secret_key_2026
SERVER_PORT=8080
# mysql.exe: leave empty to auto-detect from PATH; set explicitly if not on PATH.
MYSQL_EXE=
# Temp SQL script dir: leave empty to use %TEMP% then %TMP% then ./tmp_sql
TMP_SQL_DIR=
DB_TIMEOUT_SEC=10
# Set to 1 to refuse starting with the default JWT_SECRET.
STRICT_ENV=0
